CONNECTIONS_ACTION_LOGIN=Angemeldet
CONNECTIONS_ACTION_LOGIN_FAILED=Anmeldung abgelehnt
CONNECTIONS_ACTION_SECOND_FACTOR_FAILED=Code des zweiten Schritts abgelehnt
CONNECTIONS_ACTION_LOGOUT=Abgemeldet
