LBL_JD_RELOAD_PENDING=Ausstehend
LBL_JD_RELOAD_APPLIED=Angewendet
LBL_JD_RELOAD_FAILED=Fehlgeschlagen
LBL_JD_RELOAD_NOT_CONFIGURED=Nicht konfiguriert
