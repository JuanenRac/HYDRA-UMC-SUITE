ECOHEALTH_STATE_DOWN=Ausgefallen
ECOHEALTH_STATE_UNKNOWN=Unbekannt
ECOHEALTH_REASON_HEALTH_OK=Antwortet auf seine Gesundheitsprüfung
ECOHEALTH_REASON_HEALTH_DEGRADED=Antwortet, meldet sich aber als eingeschränkt
ECOHEALTH_REASON_HEALTH_FAILED=Antwortet, meldet aber einen Fehler
ECOHEALTH_REASON_HTTP_ERROR=Antwortet auf seinen Gesundheitspfad mit einem Fehler
ECOHEALTH_REASON_UNREACHABLE=Antwortet nicht
ECOHEALTH_REASON_UNREACHABLE_UNIT_ACTIVE=Seine Unit läuft, aber er antwortet nicht
ECOHEALTH_REASON_REACHABLE_UNIT_NOT_ACTIVE=Antwortet, obwohl seine Unit nicht aktiv ist
ECOHEALTH_REASON_UNIT_ACTIVE=Seine Unit ist aktiv
ECOHEALTH_REASON_UNIT_STARTING=Seine Unit startet
ECOHEALTH_REASON_UNIT_FAILED=Seine Unit ist fehlgeschlagen
ECOHEALTH_REASON_UNIT_INACTIVE=Seine Unit läuft nicht
ECOHEALTH_REASON_NO_SIGNAL=Kein Signal zum Lesen
ECOHEALTH_REASON_PROBE_ERROR=Die Prüfung selbst ist fehlgeschlagen
ECOHEALTH_VERSION_EXPECTED=Erwartet
ECOHEALTH_VERSION_REPORTED=Meldet
ECOHEALTH_VERSION_UNKNOWN=unbekannt
ECOHEALTH_DRIFT_BADGE=Andere Version
ECOHEALTH_LAST_SEEN=Letzte Antwort vor {ago}
ECOHEALTH_NEVER_SEEN=Keine Antwort seit dem Start des Servers
ECOHEALTH_LATENCY={ms} ms
ECOHEALTH_NO_SERVICES=Es wurde kein Dienst des Ökosystems gefunden.
ECOHEALTH_NO_MATCH=Kein Dienst passt zu diesem Filter.
ECOHEALTH_CERT_OK=Das TLS-Zertifikat des Servers ist noch {days} Tage gültig.
ECOHEALTH_CERT_EXPIRING=Das TLS-Zertifikat des Servers läuft in {days} Tagen ab ({date}).
ECOHEALTH_CERT_EXPIRED=Das TLS-Zertifikat des Servers ist abgelaufen.
ECOHEALTH_CERT_UNREADABLE=Das TLS-Zertifikat des Servers konnte nicht gelesen werden.
