UPD_LATEST=Neueste
UPD_STATE_CURRENT=Aktuell
UPD_STATE_OUTDATED=Eine neuere Version existiert
UPD_STATE_AHEAD=Neuer als die veröffentlichte
UPD_STATE_UNKNOWN=Konnte nicht verglichen werden
UPD_API_OK=API-Version {version}: kompatibel (dieses Programm braucht {minimum} oder höher)
UPD_API_TOO_OLD=API-Version {version}: zu alt (dieses Programm braucht {minimum} oder höher)
UPD_ERROR_LINE=Nicht gelesen: {detail}
