# Visual command deck

# Tool-attachment config panels (CNC/Laser and future module panels)
HEADING_CNC=CNC
HEADING_LASER=激光
HEADING_HEATED_BED=热床
GROUP_MODULE_SETTINGS=模块设置
BTN_RESET_MODULE=重置
