NODEHEALTH_HELP=El último mensaje de salud que el cerebro oyó de cada placa (solo lectura).
NODEHEALTH_SLOT=Ranura
NODEHEALTH_STATE_HEARD=Oído
NODEHEALTH_STATE_NEVER=Nunca oído
