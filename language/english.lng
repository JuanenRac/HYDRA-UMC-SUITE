DOCK_AUDIT_RECORD=Audit record
HEADING_AUDIT_RECORD=Audit record
AUDIT_ADMIN_ONLY=Only administrators can read the audit record.
AUDIT_INTRO=What the server wrote down about the changes that matter: reservations, forced releases, arming of the jog, changes of the safety limits and global stops. Each line is chained to the one before it by a SHA-256, so a line changed or removed later shows when the chain is verified.
AUDIT_FILTER_LIMIT=Number of lines
AUDIT_ALL_TYPES=All types
AUDIT_ALL_ROBOTS=All robots
AUDIT_REFRESH=Refresh
AUDIT_VERIFY=Verify the chain
AUDIT_EXPORT=Export (.jsonl)
AUDIT_COL_SEQ=No.
AUDIT_COL_OUTCOME=Outcome
AUDIT_COL_CONTROLLER=Window or device
AUDIT_COL_ADDRESS=Address
AUDIT_COL_DETAIL=Detail
AUDIT_OUTCOME_OK=done
AUDIT_OUTCOME_REFUSED=refused
AUDIT_OUTCOME_FAILED=failed
AUDIT_TYPE_CLAIM=Reservation
AUDIT_TYPE_FORCE_CLAIM=Reservation taken over
AUDIT_TYPE_RELEASE=Release
AUDIT_TYPE_FORCE_RELEASE=Release forced
AUDIT_TYPE_JOG_ARM=Jog arming
AUDIT_TYPE_SAFETY_LIMITS=Safety limits
AUDIT_TYPE_STOP_ALL=Global STOP
AUDIT_FAILURE_NETWORK=The server could not be reached.
AUDIT_FAILURE_FORBIDDEN=This account is not an administrator: the server does not give it the audit record.
AUDIT_FAILURE_SESSION=Your session ended. Sign in again.
AUDIT_FAILURE_UNAVAILABLE=This server has no audit record (an older version, or it is not available).
AUDIT_FAILURE_OTHER=The server did not give the audit record.
AUDIT_LOCKED_OFF=The audit record is locked off by the environment of the server: nothing new is written.
AUDIT_SWITCHED_OFF=The audit record is switched off in the safety limits: nothing new is written.
AUDIT_EMPTY=No lines for this filter.
AUDIT_SERVER_OK=Server: the whole chain is intact ({count} lines).
AUDIT_SERVER_BROKEN=Server: the chain is BROKEN at line {seq} ({reason}).
AUDIT_LOCAL_OK=This program: {count} lines read, every hash matches, {links} links between neighbours checked, {gaps} gaps not comparable.
AUDIT_LOCAL_BROKEN_CHANGED=This program: line {seq} does not match its own hash - it was changed.
AUDIT_LOCAL_BROKEN_LINK=This program: line {seq} does not name the line before it - a line is missing or was replaced.
AUDIT_EXPORTED=Saved to {path}
AUDIT_EXPORT_FAILED=The file could not be written: {error}
ACCESS_CONDITIONAL_LABEL=Check that the robot has not changed
ACCESS_CONDITIONAL_STANDARD=Standard: reservations, table and one-off commands
ACCESS_CONDITIONAL_STRICT=Strict: every command except STOP
ACCESS_CONDITIONAL_OFF=Off: send commands without checking
ACCESS_CONDITIONAL_HINT=Each write carries the revision of the robot this program last saw; if someone else changed the robot in between, the server refuses it (412) and the robot is read again. Jog and speed are not checked in Standard because they repeat many times a second. STOP is never checked.
MSG_NET_REJ_REVISION={what} not applied: the robot changed since this program last read it (another operator or window). It was read again from the server: check it and repeat the action if it is still wanted.
MSG_NET_REJ_STALE={what} not applied: a newer motion command from this program had already reached the robot, so this one arrived out of order. Repeat it if it is still wanted.
MSG_NET_REJ_HOME={what} rejected: the server refused to send the robot home and it did not move - the pose is not the home pose of its model, or a joint would leave its range ({detail})
MSG_ACCESS_REVISION_CHANGED={what} not applied: the robot changed since this program last read it (another operator or window). It was read again from the server: check it and try again. {detail}

# User accounts panel (administrators only)
HEADING_USERS=User accounts
USERS_ADMIN_ONLY=Only administrators can manage the accounts of the server.
USERS_INTRO=The accounts that can sign in to this server. An administrator can change settings, manage accounts and command robots; an operator can only command robots. Changing a name, a password or a role closes every session already open for that account.
USERS_COL_USERNAME=Username
USERS_COL_ROLE=Role
USERS_COL_CREATED=Created
USERS_REFRESH=Refresh
USERS_YOU=you
USERS_DELETE_TITLE=Delete account
USERS_DELETE_CONFIRM=Delete the account "{username}"? Its sessions are closed and it can no longer sign in.
USERS_CHANGE_TITLE=Change an account
USERS_SELECT_ACCOUNT=Select an account
USERS_NEW_USERNAME=New username (optional)
USERS_ROLE_UNCHANGED=Keep the role
USERS_APPLY=Apply
USERS_CREATE_TITLE=New account
USERS_ROLE_HINT=Operators can command robots but cannot change settings or manage accounts. The password needs at least 8 characters.
USERS_CREATE_BUTTON=Create account
USERS_ROLE_VIEWER=Viewer (read only)
USERS_CREATED=Account "{username}" created.
USERS_UPDATED=Account "{username}" updated; its open sessions were closed.
USERS_DELETED=Account "{username}" deleted.
USERS_ERR_USERNAME_REQUIRED=Enter a username.
USERS_ERR_PASSWORD_SHORT=The password needs at least {count} characters.
USERS_ERR_NOTHING_TO_CHANGE=Enter a new name, a new password or choose a role.
USERS_ERR_SELECT_ACCOUNT=Choose an account first.
USERS_ERR_EXISTS=An account with that name already exists.
USERS_ERR_LAST_ADMIN=The last administrator cannot be demoted or deleted.
USERS_ERR_NOT_FOUND=That account no longer exists.
USERS_FAILURE_NETWORK=The server did not answer.
USERS_FAILURE_FORBIDDEN=This account is not an administrator.
USERS_FAILURE_SESSION=The session has expired. Sign in again.
USERS_FAILURE_UNAVAILABLE=This server does not offer account management.
USERS_FAILURE_OTHER=The server refused the request.

# Access options of the Server Admin screen (STUDIO parity)
HEADING_ADMIN_SECURITY=Access options
LBL_SECURITY_AI=Local AI relay (/api/ai/*)
SECURITY_AI_OPEN=Any signed-in user
SECURITY_AI_ADMIN=Administrators only
LBL_SECURITY_INFO=Ask for sign-in on the host information (metrics, process supervisor, ecosystem status)
MSG_SECURITY_INFO_OFF_CONFIRM=Turn the sign-in requirement off? The host information (metrics, process supervisor, ecosystem status) will be readable by anyone on the network.
SECURITY_INFO_OFF_WARNING=The host information is now readable by the whole network.
LBL_SECURITY_TLS=TLS (HTTPS / WSS)
PH_SECURITY_TLS_CERT=Path of the certificate file (PEM)
PH_SECURITY_TLS_KEY=Path of the key file (PEM)
SECURITY_TLS_PATHS_REQUIRED=To turn TLS on, give the path of the certificate and of the key.
LBL_SECURITY_TLS_FINGERPRINT=Certificate fingerprint (SHA-256)
SECURITY_TLS_ACTIVE=The running server uses TLS.
SECURITY_TLS_INACTIVE=The running server does not use TLS.
SECURITY_RESTART_NOTE=The change applies on the next restart.
SECURITY_SOURCE_ENV=Set in the environment of the server (locked)
SECURITY_SOURCE_CONFIG=Saved from this screen
SECURITY_SOURCE_DEFAULT=Default
LBL_SECURITY_BLE=Bluetooth LE (phones near the server)
SECURITY_BLE_OFF=Off
SECURITY_BLE_STATE=Phones read the state
SECURITY_BLE_COMMANDS=Phones read the state and send commands
LBL_SECURITY_BLE_ENCRYPTION=Ask for an encrypted Bluetooth link
SECURITY_BLE_RUNNING=The running server: {mode}.
MSG_SECURITY_BLE_UNENCRYPTED_CONFIRM=Allow commands over Bluetooth without an encrypted link? The access token of the account travels in every command, so anyone near the server could read it.
SECURITY_BLE_UNENCRYPTED_WARNING=Commands over Bluetooth are allowed without an encrypted link: anyone near the server could read the access tokens.
TITLE_SECURITY_INFO_OFF=Turn the sign-in requirement off
TITLE_SECURITY_BLE_UNENCRYPTED=Commands without an encrypted link
LBL_SECURITY_MQTT=MQTT bridge (broker of the cell)
SECURITY_MQTT_OFF=Off
SECURITY_MQTT_STATE=Publish the state of the robots
SECURITY_MQTT_COMMANDS=Publish the state and carry out commands
PH_SECURITY_MQTT_URL=Broker address (mqtt://host:1883)
PH_SECURITY_MQTT_PREFIX=Topic prefix (hydra/swarm)
PH_SECURITY_MQTT_USER=User name for the broker
PH_SECURITY_MQTT_COMMAND_USER=Account that carries the commands out
LBL_SECURITY_MQTT_PASSWORDS=The passwords are set in the environment of the server, never here.
SECURITY_MQTT_RUNNING=The running server: {mode}.
MSG_SECURITY_MQTT_COMMANDS_CONFIRM=Carry out commands that arrive on the MQTT broker? Each runs with the role of the account named here, through the same rules as any client.
SECURITY_MQTT_COMMANDS_WARNING=Commands over MQTT are on: whoever can publish on the broker can drive the robots within the role of that account.
SECURITY_MQTT_INVALID=Check the MQTT fields: the address starts with mqtt://, mqtts://, ws:// or wss://, and commands need the account that carries them out.
TITLE_SECURITY_MQTT_COMMANDS=Commands over MQTT
LBL_SECURITY_VOICE=Voice assistant
TITLE_SECURITY_VOICE=Voice assistant
LBL_SECURITY_VOICE_HEARD=A voice reply repeats what was said (personal data; off by default)
LBL_SECURITY_VOICE_CONFIDENCE=Least confidence of the speech recognizer (0 to 1) to accept a request that starts a movement
LBL_SECURITY_VOICE_HELP=Applies from the next voice turn. 0 switches the confidence check off; a stop is never held back. The environment of the voice service, if it sets these values, wins.
SECURITY_VOICE_INVALID=The confidence must be a number from 0 to 1.
MSG_SECURITY_VOICE_CONFIRM=Lower the protection of the voice commands? Showing what was said puts personal data in every reply, and a minimum confidence of 0 accepts requests the recognizer was not sure of.
SECURITY_VOICE_HEARD_WARNING=Voice replies now repeat what was said.
SECURITY_VOICE_CONFIDENCE_WARNING=The confidence check is off: a movement can be started by a request the recognizer was not sure of.
LBL_SECURITY_MAVLINK=MAVLink 2 signing (UAV bridge)
TITLE_SECURITY_MAVLINK=MAVLink 2 signing (UAV bridge)
LBL_SECURITY_MAVLINK_KEY=File with the 32-byte signing key (empty: no signing)
PH_SECURITY_MAVLINK_KEY=/path/to/uav.key
LBL_SECURITY_MAVLINK_UNSIGNED=Still accept messages that are not signed (a vehicle that does not sign yet)
LBL_SECURITY_MAVLINK_HELP=Only the path of the key file is saved, never the key; the file must hold 32 bytes or 64 hexadecimal characters. The UAV bridge reads this when it starts.
MSG_SECURITY_MAVLINK_CONFIRM=Turn MAVLink signing off, or accept unsigned messages? Without signing, anyone who can reach the link can send commands to the vehicle.
SECURITY_MAVLINK_UNSIGNED_WARNING=Unsigned MAVLink messages are still accepted: the signing does not protect the link from forged messages.
SECURITY_MAVLINK_OFF_WARNING=MAVLink signing is off: the link to the vehicle is not authenticated.
SECURITY_MAVLINK_SIGNING_ON=Signing is on.
SECURITY_MAVLINK_SIGNING_OFF=Signing is off.
MSG_NET_OPERATOR_LOCAL_ONLY=This account is an operator: it can drive the robots, but the server accepts changes to the settings, the recorded points and the layout only from an administrator. What you changed stays in this window and is not saved.

