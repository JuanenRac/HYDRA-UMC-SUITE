MSG_SAFETY_PROBLEM_NUMBER=Not a number: {field}
MSG_SAFETY_PROBLEM_RANGE=Out of range (above 0 and at most the ceiling of the server): {field}
MSG_SAFETY_PROBLEM_MODEL=A row has no model name.
MSG_SAFETY_PROBLEM_DUPLICATE=The model is already in the table: {field}
