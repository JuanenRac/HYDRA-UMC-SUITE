MODELS_REFRESH=Atualizar a lista
MODELS_NONE=Ainda não foi submetido nenhum modelo.
MODELS_COL_NAME=Nome
MODELS_COL_CATEGORY=Categoria
MODELS_COL_DATE=Submetido
MODELS_SAVE_FAILED=Não foi possível descarregar o URDF de {name}.
MODELS_ERROR_LOGIN=O servidor pede início de sessão para listar os modelos.
MODELS_ERROR_SERVER=O servidor não conseguiu listar os modelos.
MODELS_ERROR_NETWORK=O servidor não respondeu.
MODELS_SAVE=Guardar URDF
